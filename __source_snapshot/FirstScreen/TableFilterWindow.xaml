<Window x:Class="Configurator.TableFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фильтр таблицы" Width="470" Height="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBase}"
        ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Фильтр таблицы" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}"/>
        <TextBlock Grid.Row="1"
                   Text="Фильтрация выполняется на стороне SQL Server по всей таблице."
                   Margin="0,5,0,16" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CmbColumn" Margin="0,0,8,0"
                      SelectionChanged="CmbColumn_SelectionChanged"/>
            <ComboBox x:Name="CmbOperator" Grid.Column="1"
                      SelectionChanged="CmbOperator_SelectionChanged"/>
        </Grid>
        <TextBlock x:Name="TxtTypeHint" Grid.Row="3" Margin="2,7,0,0"
                   FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
        <TextBox x:Name="TxtValue" Grid.Row="4" Margin="0,10,0,0" Height="38"
                 VerticalContentAlignment="Center" Padding="10,0"
                 Foreground="{DynamicResource BrushText}"
                 Background="{DynamicResource BrushPanel}"
                 BorderBrush="{DynamicResource BrushBorder}"
                 ToolTip="Значение фильтра"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BtnClear" Content="Сбросить" Style="{StaticResource BtnSecondary}"
                    MinWidth="92" Margin="0,0,8,0" Click="BtnClear_Click"/>
            <Button Content="Отмена" Style="{StaticResource BtnSecondary}"
                    MinWidth="82" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Content="Применить" Style="{StaticResource BtnPrimary}"
                    MinWidth="100" Click="BtnApply_Click"/>
        </StackPanel>
    </Grid>
</Window>