<Window x:Class="Configurator.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        Background="{DynamicResource BrushPanel}" Foreground="{DynamicResource BrushText}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="InputText" Grid.Row="1" Width="360" Height="32"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Style="{StaticResource BtnSecondary}" Width="90" Click="Cancel_Click"/>
            <Button Content="ОК" Style="{StaticResource BtnPrimary}" Width="90" Margin="7,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
