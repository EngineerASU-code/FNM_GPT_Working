<Window x:Class="Configurator.DependencyReplacementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Зависимости перед удалением" Width="760" Height="560" MinWidth="650" MinHeight="460" WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}">
    <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="TxtTitle" Text="Перед удалением найдены зависимости" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/><TextBlock x:Name="TxtSummary" Margin="0,5,0,10" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ItemsHost"><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="10" CornerRadius="8" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SourceTable}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold"/><TextBlock Text="{Binding RelationText}" Margin="0,3,10,0" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/><TextBlock Text="{Binding CountText}" Margin="0,4,10,0" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Новое значение" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/><TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0" Padding="7,3" ToolTip="Оставьте пустым, если зависимость нельзя безопасно переназначить."/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Отмена" Width="100" Height="34" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource BtnSecondary}"/><Button Content="Проверить и продолжить" Width="190" Height="34" Click="Ok_Click" Style="{StaticResource BtnPrimary}"/></StackPanel></Grid>
</Window>
