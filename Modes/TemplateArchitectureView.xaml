<UserControl x:Class="Configurator.TemplateArchitectureView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource BrushBase}">
    <Grid Margin="10,8,10,6">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="1,0,1,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Структура БД проекта" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/><TextBlock Text="Классы и сложные сущности определяются фактической подключенной БД" Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Проект:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/><TextBlock x:Name="TxtProjectDatabase" Text="не выбран" Width="190" VerticalAlignment="Center" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis"/><Button Content="Выбрать проект" Height="32" Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" Click="SelectProject_Click"/><Button Content="↻" Width="34" Height="32" Margin="5,0,0,0" Style="{StaticResource BtnCompact}" Click="Refresh_Click" ToolTip="Обновить структуру БД"/></StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320" MinWidth="280" MaxWidth="420"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Классы из БД" FontSize="14" FontWeight="SemiBold" Margin="4,2,4,7" Foreground="{DynamicResource BrushText}"/><ListBox x:Name="ClassList" BorderThickness="0" Background="Transparent" SelectionChanged="ClassList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Margin="2,2" Padding="7" CornerRadius="7" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding ClassNumber}" Foreground="{DynamicResource BrushAccent}" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold"/><TextBlock Text="{Binding PrimaryStorage.TableName}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
            <Border Grid.Column="2" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10"><Grid Margin="12,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0"><TextBlock x:Name="TxtClassName" Text="Выберите класс" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/><TextBlock x:Name="TxtClassMeta" Margin="0,2,0,0" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/></StackPanel><TextBlock Grid.Row="1" x:Name="TxtStorageInfo" Margin="0,8,0,8" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Margin="0,0,5,0" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Колонки фактической таблицы" Margin="10,8" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/><DataGrid x:Name="FieldGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"><DataGrid.Columns><DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="110"/><DataGridCheckBoxColumn Header="NULL" Binding="{Binding Nullable}" Width="60"/><DataGridCheckBoxColumn Header="Identity" Binding="{Binding IsIdentity}" Width="65"/></DataGrid.Columns></DataGrid></DockPanel></Border><Border Grid.Column="1" Margin="5,0,0,0" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Связанные таблицы / сложная структура" Margin="10,8" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/><ListBox x:Name="RelatedTableList" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Border Margin="6,3" Padding="7" CornerRadius="6" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"><StackPanel><TextBlock Text="{Binding TableName}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border></Grid><TextBlock Grid.Row="3" x:Name="TxtStatus" Text="Готово" Margin="0,8,0,0" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/></Grid></Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="TxtFooter" Margin="3,7,3,0" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
    </Grid>
</UserControl>
