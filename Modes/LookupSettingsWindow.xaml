<Window x:Class="Configurator.LookupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки · текстовые списки" Width="1180" Height="720" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BrushBorder}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BrushHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="Padding" Value="7,4"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Текстовые списки" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="Справочники Type для системных классов" FontSize="10" Margin="0,2,0,0" Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="База" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                <ComboBox x:Name="CmbDatabase" Width="220" Height="32" SelectionChanged="CmbDatabase_SelectionChanged"/>
                <Button Content="↻" Width="34" Height="32" Margin="5,0,0,0" Style="{StaticResource BtnCompact}" ToolTip="Обновить список текстовых списков" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Списки" Margin="4,2,4,8" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                    <ListBox Grid.Row="1" x:Name="LookupList" BorderThickness="0" Background="Transparent" SelectionChanged="LookupList_SelectionChanged"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="2,0,2,8">
                        <TextBlock x:Name="TxtLookupTitle" Text="Выберите список" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                        <TextBlock x:Name="TxtLookupMeta" Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="DataGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="DataGrid_SelectionChanged"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="BtnAdd" Content="＋ Добавить" Style="{StaticResource BtnPrimary}" Width="120" Margin="0,0,8,0" Click="BtnAdd_Click"/>
                        <Button x:Name="BtnEdit" Content="Изменить" Style="{StaticResource BtnSecondary}" Width="110" Margin="0,0,8,0" Click="BtnEdit_Click"/>
                        <Button x:Name="BtnDelete" Content="Удалить" Style="{StaticResource BtnSecondary}" Width="100" Click="BtnDelete_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource BrushTextSecondary}"/>
            <Button Content="Закрыть" Width="110" Style="{StaticResource BtnSecondary}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
