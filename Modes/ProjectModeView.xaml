<UserControl x:Class="Configurator.ProjectModeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource BrushBase}">
    <Grid Margin="10,8,10,5">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="1,0,1,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Объекты проекта" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/><TextBlock Text="Классы и дополнительные сущности фактической подключенной БД" Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Проект:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/><TextBlock x:Name="TxtProjectDatabase" Text="не выбран" Width="190" VerticalAlignment="Center" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis"/><Button Content="Выбрать проект" Height="32" Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" Click="SelectProject_Click"/><Button Content="↻" Width="34" Height="32" Margin="5,0,0,0" Style="{StaticResource BtnCompact}" Click="Refresh_Click" ToolTip="Обновить объекты"/></StackPanel></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="270" MaxWidth="380"/><ColumnDefinition Width="8"/><ColumnDefinition Width="250" MinWidth="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="0.50*"/><RowDefinition Height="8"/><RowDefinition Height="0.26*"/><RowDefinition Height="8"/><RowDefinition Height="0.24*"/></Grid.RowDefinitions><Border Grid.Row="0" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Классы" FontSize="14" FontWeight="SemiBold" Margin="10,8,10,5" Foreground="{DynamicResource BrushText}"/><ListBox x:Name="ClassList" BorderThickness="0" Background="Transparent" SelectionChanged="ClassList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Margin="2,1" Padding="6" CornerRadius="6" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding ClassNumber}" Foreground="{DynamicResource BrushAccent}" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold"/><TextBlock Text="{Binding PrimaryStorage.TableName}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="9"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border><Border Grid.Row="2" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Дополнительные элементы" FontSize="12" FontWeight="SemiBold" Margin="10,7,10,4" Foreground="{DynamicResource BrushText}"/><ListBox x:Name="OtherElementList" BorderThickness="0" Background="Transparent" SelectionChanged="OtherElementList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Margin="2,1" Padding="6" CornerRadius="6" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"><StackPanel><TextBlock Text="{Binding Title}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold"/><TextBlock Text="{Binding TableName}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="9"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border><Border Grid.Row="4" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="PLC" FontSize="12" FontWeight="SemiBold" Margin="10,7,10,4" Foreground="{DynamicResource BrushText}"/><ListBox x:Name="CmbPlcFilter" BorderThickness="0" Background="Transparent" SelectionMode="Extended" SelectionChanged="ObjectFilter_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Foreground="{DynamicResource BrushText}" Margin="10,3"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border></Grid></Border>
            <Border Grid.Column="2" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="10,9,10,6"><TextBlock x:Name="TxtClassTitle" Text="Объекты" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/><TextBlock x:Name="TxtObjectCount" Text="" Margin="0,2,0,6" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/><Button x:Name="BtnNewObject" Content="Добавить" Height="32" HorizontalAlignment="Stretch" Style="{StaticResource BtnPrimary}" Click="NewObject_Click"/></StackPanel><ListBox x:Name="ObjectList" SelectionMode="Extended" BorderThickness="0" Background="Transparent" SelectionChanged="ObjectList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Margin="8,2" Padding="7" CornerRadius="7" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"><StackPanel><TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Meta}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="9"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
            <Border Grid.Column="4" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10"><Grid Margin="12,10"><Grid.RowDefinitions><RowDefinition Height="120"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0"><Border Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9" Padding="12"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtObjectName" Text="Выберите объект" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TxtObjectMeta" Text="" Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/></StackPanel></Border></Grid><TextBlock Grid.Row="1" Text="Параметры объекта" FontSize="13" FontWeight="SemiBold" Margin="2,10,2,5" Foreground="{DynamicResource BrushText}"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="ObjectEditor" Margin="-4,0,-4,0"/></ScrollViewer><Border Grid.Row="3" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,10,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BtnDuplicate" Content="Дублировать" Style="{StaticResource BtnSecondary}" Height="34" Margin="0,0,8,0" Click="DuplicateObject_Click"/><Button x:Name="BtnDelete" Content="Удалить" Style="{StaticResource BtnSecondary}" Height="34" Margin="0,0,8,0" Click="DeleteObject_Click"/><Button x:Name="BtnSave" Content="Сохранить" Style="{StaticResource BtnPrimary}" Height="34" MinWidth="104" Click="SaveObject_Click"/></StackPanel></Border></Grid></Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="TxtStatus" Text="Выберите класс" Margin="3,6,3,0" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
