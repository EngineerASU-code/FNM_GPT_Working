<Window x:Class="Configurator.AddRowWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Новая строка" Width="980" Height="680" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}" KeyDown="Window_KeyDown">
    <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="WindowTitle" Text="Новая строка" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/><TextBlock x:Name="TxtRecordHint" Grid.Row="1" Margin="0,6,0,8" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/><ScrollViewer x:Name="FieldsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FieldsPanel"/></ScrollViewer><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Отмена" Width="100" Height="34" Margin="0,0,8,0" Click="BtnCancel_Click" Style="{StaticResource BtnSecondary}"/><Button Content="Добавить" Width="120" Height="34" Click="BtnConfirm_Click" Style="{StaticResource BtnPrimary}"/></StackPanel></Grid>
</Window>
