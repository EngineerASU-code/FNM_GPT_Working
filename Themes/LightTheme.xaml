<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorBase">#F5F7FA</Color>
    <Color x:Key="ColorPanel">#FFFFFF</Color>
    <Color x:Key="ColorBorder">#D9DEE7</Color>
    <Color x:Key="ColorText">#1F2937</Color>
    <Color x:Key="ColorTextSecondary">#6B7280</Color>
    <Color x:Key="ColorAccent">#3478F6</Color>
    <Color x:Key="ColorHover">#F0F4FA</Color>
    <Color x:Key="ColorSelected">#E7F0FF</Color>
    <SolidColorBrush x:Key="BrushBase" Color="{StaticResource ColorBase}"/>
    <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource ColorPanel}"/>
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushHover" Color="{StaticResource ColorHover}"/>
    <SolidColorBrush x:Key="BrushSelected" Color="{StaticResource ColorSelected}"/>
</ResourceDictionary>