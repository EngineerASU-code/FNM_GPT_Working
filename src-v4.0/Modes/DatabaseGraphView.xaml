<UserControl x:Class="Configurator.DatabaseGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBase}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="2,0,2,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Граф структуры БД" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                <TextBlock x:Name="TxtGraphDescription" Text="Фактические таблицы и обнаруженные связи подключенной БД" Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Центр:" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,5,0"/>
                <TextBlock x:Name="TxtSelectedTable" Text="все таблицы" Width="180" VerticalAlignment="Center" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis"/>
                <Button Content="↻" Width="34" Height="32" Margin="7,0,0,0" Style="{StaticResource BtnCompact}" Click="Refresh_Click" ToolTip="Обновить граф"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="GraphCanvas" Width="1800" Height="1200" Background="Transparent"/>
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="2" x:Name="TxtGraphStatus" Text="Выберите проект для построения графа" Margin="3,6,3,0" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
