<UserControl x:Class="Configurator.DatabaseGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBase}">
    <Grid Margin="8,6,8,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Граф связей БД" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="Фактические и логические зависимости выбранного проекта" Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Центр:" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" Margin="0,0,5,0"/>
                    <TextBlock x:Name="TxtSelectedTable" Text="не выбрана" Width="175" VerticalAlignment="Center" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="GraphRefreshButton" Content="↻" Width="34" Height="30" Margin="6,0,0,0" Style="{StaticResource BtnCompact}" Click="Refresh_Click" ToolTip="Обновить граф"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="240" MaxWidth="330"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="7">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="4,2,4,7">
                        <TextBlock Text="Таблицы" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                        <TextBlock Text="Выберите центральную таблицу" Margin="0,2,0,0" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </StackPanel>
                    <ListBox x:Name="GraphTableList" BorderThickness="0" Background="Transparent" Padding="1" SelectionChanged="GraphTableList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TableCard" CornerRadius="7" Padding="8,7" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FullName}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="›" Foreground="{DynamicResource BrushTextSecondary}" FontSize="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                        <Setter TargetName="TableCard" Property="Background" Value="{DynamicResource BrushSelected}"/>
                                        <Setter TargetName="TableCard" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                        <Setter TargetName="TableCard" Property="Background" Value="{DynamicResource BrushHover}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="7">
                <Grid>
                    <Border Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="4">
                            <Grid Width="1750" Height="950">
                                <Canvas x:Name="GraphCanvas" Width="1750" Height="950" Visibility="Collapsed"/>
                                <Canvas x:Name="CompactGraphCanvas" Width="1750" Height="950" Background="Transparent"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="7" Padding="9,7">
                        <StackPanel>
                            <TextBlock Text="Связи" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="сплошная — FK · пунктир — логическая" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtGraphScope" Text="" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="320"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="TxtGraphStatus" Text="Выберите проект для построения графа" Margin="3,6,3,0" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>