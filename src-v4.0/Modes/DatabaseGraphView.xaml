<UserControl x:Class="Configurator.DatabaseGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBase}">
    <Grid Margin="12,10,12,7">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="1,0,1,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Структура проекта" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="Фактическая архитектура подключенной БД и обнаруженные связи между таблицами" Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9" Padding="9,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Центр" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" Margin="0,0,7,0"/>
                    <TextBlock x:Name="TxtSelectedTable" Text="все таблицы" Width="190" VerticalAlignment="Center" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis" ToolTip="Центральная таблица графа"/>
                    <Button Content="↻" Width="34" Height="30" Margin="7,0,0,0" Style="{StaticResource BtnCompact}" Click="Refresh_Click" ToolTip="Обновить граф"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="1" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="8">
            <Grid>
                <Border Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="4">
                        <Canvas x:Name="GraphCanvas" Width="2200" Height="1500" Background="Transparent"/>
                    </ScrollViewer>
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="9,7">
                    <StackPanel>
                        <TextBlock Text="Граф БД" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushText}"/>
                        <TextBlock Text="PK / FK и обнаруженные связи" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <TextBlock Grid.Row="2" x:Name="TxtGraphStatus" Text="Выберите проект для построения графа" Margin="3,7,3,0" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
    </Grid>
</UserControl>
