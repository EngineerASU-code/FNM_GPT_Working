<Window x:Class="Configurator.AdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Требуется пароль" Width="390" Height="205"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushBase}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Защищённое изменение" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}"/>
        <TextBlock Grid.Row="1" Text="Для изменения системного класса требуется пароль администратора."
                   Margin="0,7,0,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrushTextSecondary}"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="PasswordInput" Height="36" Padding="10,7"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource BrushPanel}"
                         Foreground="{DynamicResource BrushText}"
                         BorderBrush="{DynamicResource BrushBorder}"
                         KeyDown="PasswordInput_KeyDown"/>
            <Button Grid.Column="1" Content="Разблокировать" Style="{StaticResource BtnPrimary}"
                    Margin="10,0,0,0" MinWidth="125" Click="BtnUnlock_Click"/>
        </Grid>
    </Grid>
</Window>