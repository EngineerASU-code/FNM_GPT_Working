<UserControl x:Class="Configurator.ProjectModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrushBase}">
    <Grid Margin="12,10,12,7">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="1,0,1,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Объекты проекта" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="Фактические экземпляры и параметры из подключенной БД" Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9" Padding="9,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Проект" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" Margin="0,0,7,0"/>
                    <TextBlock x:Name="TxtProjectDatabase" Text="не выбран" Width="190" VerticalAlignment="Center" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis" ToolTip="Текущая база проекта"/>
                    <Button Content="Выбрать проект" Height="30" Margin="9,0,0,0" Style="{StaticResource BtnSecondary}" Click="SelectProject_Click"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" MinWidth="270" MaxWidth="330"/><ColumnDefinition Width="9"/>
                <ColumnDefinition Width="320" MinWidth="290" MaxWidth="390"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*" MinWidth="520"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="9">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="0.48*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="10,9,10,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Классы" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                                <TextBlock Text="3 режим" Grid.Column="1" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </Grid>
                            <ListBox x:Name="ClassList" BorderThickness="0" Background="Transparent" Padding="4,0" SelectionChanged="ClassList_SelectionChanged">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Border CornerRadius="7" Padding="5" Background="Transparent"><Grid MinHeight="36">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="25" CornerRadius="6" HorizontalAlignment="Center" Background="{DynamicResource BrushSelected}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"><TextBlock Text="{Binding ClassNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}" FontSize="11" FontWeight="SemiBold"/></Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="›" Margin="4,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" FontSize="17"/>
                                    </Grid></Border>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9" Padding="9,7">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Фильтры и элементы проекта" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="1,0,1,5"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
                                <TextBlock Text="PLC" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="2,2,2,2"/>
                                <ListBox x:Name="CmbPlcFilter" SelectionMode="Extended" BorderThickness="0" Background="Transparent" SelectionChanged="ObjectFilter_SelectionChanged" MinHeight="70">
                                    <ListBox.ItemTemplate><DataTemplate><Border CornerRadius="5" Padding="6,4" Margin="0,1" Background="Transparent"><TextBlock Text="{Binding Title}" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></Border></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Separator Margin="2,5"/>
                                <TextBlock Text="Доступные сущности" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" Margin="2,2,2,3"/>
                                <WrapPanel>
                                    <Border CornerRadius="5" Background="{DynamicResource BrushSelected}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="8,4" Margin="0,0,5,4"><TextBlock Text="PLC" Foreground="{DynamicResource BrushText}" FontSize="10"/></Border>
                                    <Border CornerRadius="5" Background="{DynamicResource BrushSelected}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="8,4" Margin="0,0,5,4"><TextBlock Text="Area" Foreground="{DynamicResource BrushText}" FontSize="10"/></Border>
                                    <Border CornerRadius="5" Background="{DynamicResource BrushSelected}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Padding="8,4" Margin="0,0,5,4"><TextBlock Text="Unit" Foreground="{DynamicResource BrushText}" FontSize="10"/></Border>
                                </WrapPanel>
                            </StackPanel></ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="9">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="2,1,2,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtClassTitle" Text="Объекты" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                        <TextBlock x:Name="TxtObjectCount" Grid.Column="1" Text="" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </Grid>
                    <Button x:Name="BtnNewObject" Content="＋  Добавить объект" Height="34" Margin="0,8,0,0" HorizontalAlignment="Stretch" Style="{StaticResource BtnPrimary}" Click="NewObject_Click" ToolTip="Добавить новый объект"/>
                    </StackPanel>
                    <ListBox x:Name="ObjectList" SelectionMode="Extended" BorderThickness="0" Background="Transparent" Padding="1" SelectionChanged="ObjectList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border x:Name="ObjectCard" CornerRadius="8" Padding="10,9" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Background="{DynamicResource BrushBase}">
                                <Grid>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"><Setter TargetName="ObjectCard" Property="Background" Value="{DynamicResource BrushSelected}"/><Setter TargetName="ObjectCard" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/></DataTrigger>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"><Setter TargetName="ObjectCard" Property="Background" Value="{DynamicResource BrushHover}"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="4" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid><Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,5,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="TxtObjectName" Text="Выберите объект" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="TxtObjectMeta" Text="Выберите класс и объект слева" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                        <Border Grid.Column="1" Background="{DynamicResource BrushSelected}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="9" Padding="8" Margin="5,0,0,0"><Grid><TextBlock x:Name="TxtPreviewGlyph" Text="OBJ" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}"/><TextBlock x:Name="TxtPreviewClass" Text="" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" Foreground="{DynamicResource BrushTextSecondary}" FontSize="9"/></Grid></Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="2,9,2,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Параметры объекта" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/><TextBlock Text="Связанные поля — списки" Grid.Column="1" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/></Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="ObjectEditor" Margin="-2,0,-2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions></Grid></ScrollViewer>
                    <Border Grid.Row="3" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="7" Margin="0,9,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Изменения сохраняются непосредственно в БД проекта" Foreground="{DynamicResource BrushTextSecondary}" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BtnDuplicate" Content="Дублировать" Style="{StaticResource BtnSecondary}" Height="32" Margin="8,0,6,0" Click="DuplicateObject_Click"/><Button x:Name="BtnDelete" Content="Удалить" Style="{StaticResource BtnSecondary}" Height="32" Margin="0,0,6,0" Click="DeleteObject_Click"/><Button x:Name="BtnSave" Content="Сохранить" Style="{StaticResource BtnPrimary}" Height="32" MinWidth="104" Click="SaveObject_Click"/></StackPanel></Grid></Border>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="3,7,3,0"><TextBlock x:Name="TxtStatus" Text="Выберите класс" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis"/></DockPanel>
    </Grid>
</UserControl>