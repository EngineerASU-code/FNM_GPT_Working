<Window x:Class="Configurator.SettingsPlaceholderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="460" Height="260" MinWidth="420" MinHeight="220"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Настройки" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
            <TextBlock Text="Раздел подготовлен под будущие настройки приложения.
Здесь позже появятся общие параметры Configurator." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
        </StackPanel>
        <Button Grid.Row="1" Content="Закрыть" Width="110" HorizontalAlignment="Right" Style="{StaticResource BtnSecondary}" Click="Close_Click"/>
    </Grid>
</Window>