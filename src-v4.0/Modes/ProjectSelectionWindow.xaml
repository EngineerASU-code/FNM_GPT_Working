<Window x:Class="Configurator.ProjectSelectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Выбор проекта" Width="520" Height="460" MinWidth="520" MinHeight="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource BrushBase}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Выбор проекта" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
            <TextBlock Text="Выберите подключенную базу или подключите новую." Margin="0,4,0,0" Foreground="{DynamicResource BrushTextSecondary}"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="10">
            <ListBox x:Name="ProjectList" BorderThickness="0" Background="Transparent" SelectionMode="Single">
                <ListBox.ItemTemplate><DataTemplate><Border Padding="10,9" Margin="2" CornerRadius="6"><StackPanel><TextBlock Text="{Binding}" Foreground="{DynamicResource BrushText}" FontSize="14"/><TextBlock Text="Подключенная база данных" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="＋ Подключить новую" Style="{StaticResource BtnSecondary}" Click="ConnectNew_Click" HorizontalAlignment="Left"/>
            <Button Grid.Column="1" Content="Отмена" Style="{StaticResource BtnSecondary}" Width="100" Click="Cancel_Click"/>
            <Button Grid.Column="3" Content="Выбрать" Style="{StaticResource BtnPrimary}" Width="110" Click="Select_Click"/>
        </Grid>
    </Grid>
</Window>