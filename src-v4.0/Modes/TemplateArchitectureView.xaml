<UserControl x:Class="Configurator.TemplateArchitectureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Configurator"
             Background="{DynamicResource BrushBase}">
    <UserControl.Resources>
        <DataTemplate x:Key="ClassItemTemplate">
            <Border Margin="2,2" Padding="7" CornerRadius="7" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="28" Height="24" CornerRadius="6" HorizontalAlignment="Center" Background="{DynamicResource BrushSelected}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                        <TextBlock Text="{Binding ClassNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="6,0,4,0">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PrimaryStorage.TableName}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Available, Converter={StaticResource BoolToAvailabilityConverter}}" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="10,8,10,6">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="1,0,1,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Структура проекта" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="Фактическая архитектура подключенной БД" Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Проект:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                <TextBlock x:Name="TxtProjectDatabase" Text="не выбран" Width="190" VerticalAlignment="Center" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis"/>
                <Button Content="Выбрать проект" Height="32" Margin="8,0,0,0" Style="{StaticResource BtnSecondary}" Click="SelectProject_Click"/>
                <Button Content="↻" Width="34" Height="32" Margin="5,0,0,0" Style="{StaticResource BtnCompact}" ToolTip="Обновить структуру" Click="Refresh_Click"/>
            </StackPanel>
        </Grid>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Граф связей"><local:DatabaseGraphView x:Name="DatabaseGraphControl"/></TabItem>
            <TabItem Header="Классы и поля">
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="260" MaxWidth="340"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Классы" FontSize="14" FontWeight="SemiBold" Margin="10,8,10,5" Foreground="{DynamicResource BrushText}"/>
                            <Button x:Name="AddClassButton" DockPanel.Dock="Top" Content="＋  Новый класс" Height="36" Margin="8,0,8,7" Style="{StaticResource BtnPrimary}" Click="AddClass_Click"/>
                            <ListBox x:Name="ClassList" Margin="5,0,5,5" ItemTemplate="{StaticResource ClassItemTemplate}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" SelectionChanged="ClassList_SelectionChanged"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10">
                        <Grid Margin="12,10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TxtClassName" Text="Выберите класс" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                                    <TextBlock x:Name="TxtClassMeta" Margin="0,2,0,0" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="№ класса" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,5,0"/>
                                    <TextBox x:Name="TxtClassNumber" Width="64" Height="32" Margin="0,0,10,0"/>
                                    <CheckBox x:Name="ChkAvailable" Content="Использовать в проекте" VerticalAlignment="Center" Checked="Available_Checked" Unchecked="Available_Unchecked"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" x:Name="TxtStorageInfo" Margin="0,8,0,6" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <Grid Grid.Row="2">
                                <Border x:Name="ComplexNotice" Visibility="Collapsed" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel><TextBlock Text="Составной класс" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/><TextBlock x:Name="TxtComplexNotice" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/></StackPanel>
                                </Border>
                                <ScrollViewer x:Name="FieldsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="GroupHost"/></ScrollViewer>
                            </Grid>
                            <Grid Grid.Row="3" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnAddField" Content="+ Поле" Style="{StaticResource BtnCompact}" Click="AddField_Click"/>
                                    <Button x:Name="BtnDeleteField" Content="Удалить поле" Style="{StaticResource BtnCompact}" Margin="5,0,0,0" Click="DeleteField_Click"/>
                                    <Button x:Name="BtnSyncSql" Content="Синхронизировать с SQL" Style="{StaticResource BtnCompact}" Margin="5,0,0,0" Click="LoadSqlStructure_Click"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="BtnSaveClass" Content="Сохранить" Style="{StaticResource BtnPrimary}" Height="32" Margin="5,0,0,0" Click="SaveClass_Click"/>
                                    <Button x:Name="BtnRestoreArchived" Content="Восстановить объекты" Style="{StaticResource BtnSecondary}" Height="32" MinWidth="150" Margin="5,0,0,0" Click="RestoreArchived_Click" Visibility="Collapsed"/>
                                    <Button x:Name="BtnDeleteClass" Content="Удалить класс" Style="{StaticResource BtnSecondary}" Height="32" Margin="5,0,0,0" Click="DeleteClass_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="3,6,3,0"><TextBlock x:Name="TxtStatus" Text="Готово" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/></DockPanel>
    </Grid>
</UserControl>
