<Window x:Class="Configurator.HotkeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Горячие клавиши" Width="520" Height="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBase}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Горячие клавиши" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
        <Border Grid.Row="1" Margin="0,14,0,14" Padding="14" Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Ctrl + Z" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,12,10"/>
                <TextBlock Grid.Column="1" Text="Отменить последнее действие" Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Text="Delete" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,12,10"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Удалить выбранный элемент" Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="2" Text="Enter" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,12,10"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Открыть выбранный элемент" Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="3" Text="Esc" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Закрыть текущее всплывающее окно" Foreground="{DynamicResource BrushText}"/>
            </Grid>
        </Border>
        <Button Grid.Row="2" Content="Закрыть" Width="100" HorizontalAlignment="Right" Click="Close_Click"/>
    </Grid>
</Window>
