<Window x:Class="Configurator.ThemePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тема оформления" Height="460" Width="700"
        MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushBase}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите тему оформления"
                   FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}"
                   Margin="0,0,0,20"/>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,20">

            <Border x:Name="CardLight" Cursor="Hand" CornerRadius="8" Margin="5"
                    BorderThickness="2" BorderBrush="#CCCCCC"
                    MouseLeftButtonDown="CardLight_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="120" Height="70" CornerRadius="6" Margin="0,0,0,12">
                        <Border Background="#F5F5F5" CornerRadius="6">
                            <StackPanel Margin="10">
                                <Rectangle Fill="#2C88CC" Height="8" RadiusX="2" RadiusY="2" Margin="0,0,0,6"/>
                                <Rectangle Fill="#333333" Height="4" RadiusX="2" RadiusY="2" Margin="0,0,0,4"/>
                                <Rectangle Fill="#CCCCCC" Height="4" RadiusX="2" RadiusY="2"/>
                            </StackPanel>
                        </Border>
                    </Border>
                    <!-- === P2-14: DynamicResource вместо фиксированных цветов === -->
                    <TextBlock Text="☀️ Светлая" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="По умолчанию" FontSize="11"
                               Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="CardDark" Cursor="Hand" CornerRadius="8" Margin="5"
                    BorderThickness="2" BorderBrush="#444"
                    MouseLeftButtonDown="CardDark_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="120" Height="70" CornerRadius="6" Margin="0,0,0,12">
                        <Border Background="#1E1E1E" CornerRadius="6">
                            <StackPanel Margin="10">
                                <Rectangle Fill="#4DA6FF" Height="8" RadiusX="2" RadiusY="2" Margin="0,0,0,6"/>
                                <Rectangle Fill="#E0E0E0" Height="4" RadiusX="2" RadiusY="2" Margin="0,0,0,4"/>
                                <Rectangle Fill="#555" Height="4" RadiusX="2" RadiusY="2"/>
                            </StackPanel>
                        </Border>
                    </Border>
                    <!-- === P2-14: DynamicResource === -->
                    <TextBlock Text="🌙 Тёмная" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushText}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Для ночи" FontSize="11"
                               Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnReset" Content="По умолчанию"
                    Style="{StaticResource BtnSecondary}"
                    MinWidth="180"
                    Margin="0,0,10,0"
                    Click="BtnReset_Click"/>
            <Button Grid.Column="1" x:Name="BtnCustomize" Content="Настроить цвета"
                    Style="{StaticResource BtnPrimary}"
                    MinWidth="190"
                    Margin="0,0,10,0"
                    Click="BtnCustomize_Click"/>
            <Button Grid.Column="2" x:Name="BtnClose" Content="Закрыть"
                    Style="{StaticResource BtnSecondary}"
                    MinWidth="140"
                    Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
