<Window x:Class="Configurator.ThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка темы" Height="620" Width="620"
        MinWidth="620" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BrushBase}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🎨 Настройка цветовой палитры"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <StackPanel>

                <TextBlock Text="Название пресета:" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="TxtPresetName" FontSize="13" Padding="8,6" Margin="0,0,0,16"/>

                <TextBlock Text="Базовый фон:" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PreviewBase" Height="32" CornerRadius="4"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/>
                    <Button Grid.Column="1" Content="Выбрать" Style="{StaticResource BtnCompact}"
                            Width="112" Margin="12,0,0,0" Click="BtnSelectBase_Click"/>
                </Grid>

                <TextBlock Text="Фон панелей:" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PreviewPanel" Height="32" CornerRadius="4"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/>
                    <Button Grid.Column="1" Content="Выбрать" Style="{StaticResource BtnCompact}"
                            Width="112" Margin="12,0,0,0" Click="BtnSelectPanel_Click"/>
                </Grid>

                <TextBlock Text="Границы:" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PreviewBorder" Height="32" CornerRadius="4"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/>
                    <Button Grid.Column="1" Content="Выбрать" Style="{StaticResource BtnCompact}"
                            Width="112" Margin="12,0,0,0" Click="BtnSelectBorder_Click"/>
                </Grid>

                <TextBlock Text="Текст:" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PreviewText" Height="32" CornerRadius="4"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/>
                    <Button Grid.Column="1" Content="Выбрать" Style="{StaticResource BtnCompact}"
                            Width="112" Margin="12,0,0,0" Click="BtnSelectText_Click"/>
                </Grid>

                <TextBlock Text="Акцент:" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PreviewAccent" Height="32" CornerRadius="4"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/>
                    <Button Grid.Column="1" Content="Выбрать" Style="{StaticResource BtnCompact}"
                            Width="112" Margin="12,0,0,0" Click="BtnSelectAccent_Click"/>
                </Grid>

                <TextBlock Text="Наведение:" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PreviewHover" Height="32" CornerRadius="4"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/>
                    <Button Grid.Column="1" Content="Выбрать" Style="{StaticResource BtnCompact}"
                            Width="112" Margin="12,0,0,0" Click="BtnSelectHover_Click"/>
                </Grid>

                <TextBlock Text="Выделение:" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"
                           Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PreviewSelected" Height="32" CornerRadius="4"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/>
                    <Button Grid.Column="1" Content="Выбрать" Style="{StaticResource BtnCompact}"
                            Width="112" Margin="12,0,0,0" Click="BtnSelectSelected_Click"/>
                </Grid>
                <TextBlock Text="ComboBox" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,6,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Фон" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/><Border x:Name="PreviewComboBoxBackground" Height="28" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/><Button Tag="ComboBoxBackground" Content="Выбрать" Style="{StaticResource BtnCompact}" Click="BtnSelectComboColor_Click" Margin="0,4,0,10"/>
                        <TextBlock Text="Текст" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/><Border x:Name="PreviewComboBoxForeground" Height="28" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/><Button Tag="ComboBoxForeground" Content="Выбрать" Style="{StaticResource BtnCompact}" Click="BtnSelectComboColor_Click" Margin="0,4,0,10"/>
                        <TextBlock Text="Граница" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/><Border x:Name="PreviewComboBoxBorder" Height="28" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/><Button Tag="ComboBoxBorder" Content="Выбрать" Style="{StaticResource BtnCompact}" Click="BtnSelectComboColor_Click" Margin="0,4,0,10"/>
                        <TextBlock Text="Фон списка" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/><Border x:Name="PreviewComboBoxPopupBackground" Height="28" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/><Button Tag="ComboBoxPopupBackground" Content="Выбрать" Style="{StaticResource BtnCompact}" Click="BtnSelectComboColor_Click" Margin="0,4,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock Text="Текст списка" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/><Border x:Name="PreviewComboBoxPopupForeground" Height="28" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/><Button Tag="ComboBoxPopupForeground" Content="Выбрать" Style="{StaticResource BtnCompact}" Click="BtnSelectComboColor_Click" Margin="0,4,0,10"/>
                        <TextBlock Text="Hover фон" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/><Border x:Name="PreviewComboBoxItemHoverBackground" Height="28" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/><Button Tag="ComboBoxItemHoverBackground" Content="Выбрать" Style="{StaticResource BtnCompact}" Click="BtnSelectComboColor_Click" Margin="0,4,0,10"/>
                        <TextBlock Text="Hover текст" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/><Border x:Name="PreviewComboBoxItemHoverForeground" Height="28" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/><Button Tag="ComboBoxItemHoverForeground" Content="Выбрать" Style="{StaticResource BtnCompact}" Click="BtnSelectComboColor_Click" Margin="0,4,0,10"/>
                        <TextBlock Text="Выбранный фон" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/><Border x:Name="PreviewComboBoxItemSelectedBackground" Height="28" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/><Button Tag="ComboBoxItemSelectedBackground" Content="Выбрать" Style="{StaticResource BtnCompact}" Click="BtnSelectComboColor_Click" Margin="0,4,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="Выбранный текст" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/><Border x:Name="PreviewComboBoxItemSelectedForeground" Height="28" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/><Button Tag="ComboBoxItemSelectedForeground" Content="Выбрать" Style="{StaticResource BtnCompact}" Click="BtnSelectComboColor_Click" Margin="0,4,0,10"/>
                        <TextBlock Text="Hover граница" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/><Border x:Name="PreviewComboBoxBorderHover" Height="28" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/><Button Tag="ComboBoxBorderHover" Content="Выбрать" Style="{StaticResource BtnCompact}" Click="BtnSelectComboColor_Click" Margin="0,4,0,10"/>
                        <TextBlock Text="Focus граница" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/><Border x:Name="PreviewComboBoxBorderFocus" Height="28" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/><Button Tag="ComboBoxBorderFocus" Content="Выбрать" Style="{StaticResource BtnCompact}" Click="BtnSelectComboColor_Click" Margin="0,4,0,10"/>
                        <TextBlock Text="Отключённый фон" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/><Border x:Name="PreviewComboBoxDisabledBackground" Height="28" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/><Button Tag="ComboBoxDisabledBackground" Content="Выбрать" Style="{StaticResource BtnCompact}" Click="BtnSelectComboColor_Click" Margin="0,4,0,10"/>
                        <TextBlock Text="Отключённый текст" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/><Border x:Name="PreviewComboBoxDisabledForeground" Height="28" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"/><Button Tag="ComboBoxDisabledForeground" Content="Выбрать" Style="{StaticResource BtnCompact}" Click="BtnSelectComboColor_Click" Margin="0,4,0,10"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Style="{StaticResource BtnSecondary}"
                    Width="100" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Сохранить" Style="{StaticResource BtnPrimary}"
                    Width="110" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
