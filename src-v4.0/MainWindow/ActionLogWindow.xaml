<Window x:Class="Configurator.ActionLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал действий" Width="760" Height="500"
        MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushBase}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Журнал действий" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="Изменения, операции и нажатия кнопок"
                           Margin="0,3,0,0" FontSize="11"
                           Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
            <TextBlock x:Name="TxtCount" Grid.Column="1" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="9" Padding="6">
            <ListBox x:Name="LogList" BorderThickness="0" Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="9,7" Margin="0,1"
                                Background="{DynamicResource BrushBase}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}"
                                           Foreground="{DynamicResource BrushTextSecondary}" FontSize="10"/>
                                <TextBlock Grid.Column="1" Text="{Binding Description}"
                                           Foreground="{DynamicResource BrushText}" FontSize="11"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Закрыть" Style="{StaticResource BtnSecondary}" Width="100" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>