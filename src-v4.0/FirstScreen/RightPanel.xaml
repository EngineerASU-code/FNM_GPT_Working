<UserControl x:Class="Configurator.RightPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource BrushBase}" Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TableTitle" Text="Выберите таблицу слева"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="Просмотр и редактирование данных"
                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                           Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnFilter" Content="⌕  Фильтр"
                        Style="{StaticResource BtnCompact}" MinWidth="108" Margin="0,0,8,0"
                        ToolTip="Фильтр текущей таблицы"/>
                <Button x:Name="BtnToggleFields"
                        Content="Поля записи  ▼"
                        Style="{StaticResource BtnCompact}"
                        MinWidth="144"
                        ToolTip="Развернуть поля записи"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" x:Name="InputPanel"
                Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="10" Padding="14" Margin="0,0,0,12"
                Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Поля записи" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushText}"/>
                    <TextBlock x:Name="FieldsEmptyHint"
                               Text="Выберите одну строку в таблице"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource BrushTextSecondary}"
                               FontSize="11"/>
                </Grid>
                <WrapPanel x:Name="FieldsContainer" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True">
            <DataGrid x:Name="DataTableGrid"
                      Background="{DynamicResource BrushPanel}"
                      Foreground="{DynamicResource BrushText}"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BrushBorder}"
                      HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      IsReadOnly="True" AutoGenerateColumns="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      RowHeight="34"
                      ColumnHeaderHeight="38"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushSelected}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0" ClipToBounds="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnAdd" Content="＋ Добавить" Style="{StaticResource BtnPrimary}" MinWidth="130" Margin="0,0,8,0"/>
                <Button x:Name="BtnUpdate" Content="Изменить" Style="{StaticResource BtnSecondary}" MinWidth="108" Margin="0,0,8,0"/>
                <Button x:Name="BtnDuplicate" Content="Дублировать" Style="{StaticResource BtnSecondary}" MinWidth="132" Margin="0,0,8,0"/>
                <Button x:Name="BtnDelete" Content="Удалить" Style="{StaticResource BtnSecondary}" MinWidth="96"/>
                <Button x:Name="BtnUndo" Content="↶" Style="{StaticResource BtnCompact}" Width="38" Margin="8,0,8,0" ToolTip="Ctrl+Z · отменить последнее действие"/>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnFirst" Content="«" Style="{StaticResource BtnCompact}" Width="34" Margin="0,0,5,0"/>
                <Button x:Name="BtnPrev" Content="‹" Style="{StaticResource BtnCompact}" Width="34" Margin="0,0,8,0"/>
                <Border Background="{DynamicResource BrushPanel}" BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1" CornerRadius="7" Padding="12,7" MinWidth="100">
                    <TextBlock x:Name="PageInfo" Text="—" HorizontalAlignment="Center"
                               Foreground="{DynamicResource BrushText}" FontSize="12"/>
                </Border>
                <Button x:Name="BtnNext" Content="›" Style="{StaticResource BtnCompact}" Width="34" Margin="8,0,5,0"/>
                <Button x:Name="BtnLast" Content="»" Style="{StaticResource BtnCompact}" Width="34"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>