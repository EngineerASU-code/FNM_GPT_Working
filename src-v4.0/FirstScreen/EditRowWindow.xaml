<Window x:Class="Configurator.EditRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменить строку"
        Height="590" Width="700" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BrushBase}"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="WindowTitle"
                   FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource BrushText}"
                   Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <WrapPanel x:Name="FieldsPanel"/>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="ValidationHint"
                   FontSize="12"
                   Foreground="#FF6B6B"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="❌ Отмена"
                    Style="{StaticResource BtnSecondary}"
                    Margin="0,0,10,0"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="💾 Сохранить"
                    Style="{StaticResource BtnPrimary}"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
