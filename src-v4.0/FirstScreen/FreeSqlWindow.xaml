<Window x:Class="Configurator.FreeSqlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свободный ввод SQL" Width="1120" Height="720" MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushBase}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Свободный ввод" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="SQL выполняется только в выбранном контексте базы данных и не изменяет режимы приложения."
                           Margin="0,3,0,0" FontSize="11"
                           Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="База данных:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource BrushTextSecondary}"/>
                <ComboBox x:Name="CmbDatabase" Width="260"
                          SelectionChanged="CmbDatabase_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <TextBox x:Name="TxtSql" Grid.Row="1" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13" Padding="12" TextWrapping="NoWrap"
                 Background="{DynamicResource BrushPanel}" Foreground="{DynamicResource BrushText}"
                 BorderBrush="{DynamicResource BrushBorder}"/>

        <Grid Grid.Row="2" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushTextSecondary}" Text="Готово"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Очистить" Style="{StaticResource BtnSecondary}"
                        MinWidth="90" Margin="0,0,8,0" Click="BtnClear_Click"/>
                <Button x:Name="BtnExecute" Content="Выполнить"
                        Style="{StaticResource BtnPrimary}" MinWidth="110"
                        Click="BtnExecute_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource BrushPanel}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True">
            <DataGrid x:Name="ResultGrid" AutoGenerateColumns="True" IsReadOnly="True"
                      CanUserAddRows="False" Background="{DynamicResource BrushPanel}"
                      Foreground="{DynamicResource BrushText}" BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BrushBorder}"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
        </Border>
    </Grid>
</Window>